{
  "$schema": "tool-definition/v1",
  "tool": {
    "id": "bean-query",
    "title": "Query the beans knowledge graph",
    "description": "Query the beans knowledge graph using named graph analytics or arbitrary SPARQL 1.1.",
    "install": {
      "none": true
    },
    "invoke": {
      "mcp": {
        "tool": "bean_query"
      },
      "inProcess": {
        "module": "src/tools/beans-prime.ts"
      }
    },
    "io": {
      "inputs": [
        {
          "name": "named",
          "schema": {
            "$type": "Text"
          },
          "description": "Pre-defined named query (e.g. safe_drain_candidates, actionable_leaves).",
          "required": false
        },
        {
          "name": "sparql",
          "schema": {
            "$type": "Text"
          },
          "description": "Arbitrary SPARQL 1.1 SELECT query over the bean store.",
          "required": false
        },
        {
          "name": "format",
          "schema": {
            "$type": "Text"
          },
          "description": "Output format: table, json, or ids.",
          "required": false
        }
      ],
      "outputs": [
        {
          "name": "result",
          "schema": {
            "$type": "Markdown"
          },
          "description": "Query results formatted as table, JSON, or IDs."
        }
      ]
    },
    "satisfies": [
      "todo-manager",
      "bean-coordination"
    ],
    "requires": {
      "network": false
    }
  }
}
