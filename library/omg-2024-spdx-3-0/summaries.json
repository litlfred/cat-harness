    {
      "block": "library/omg-2024-spdx-3-0/blocks/prose-sec-047",
      "source": "sections/sec-047-elementcollection.md",
      "source_hash": "6203ac847cc9ec6f506e733e283d93d0371efcec3c17b49a82abbc3dc4d75d3b",
      "narrative": [
        {
          "text": "Section 8.1.9 (`ElementCollection`): Defines the abstract `/Core/ElementCollection` class (subclass of `/Core/Element`) for collections of elements defaulting to `core` profile conformance, requiring at least one `rootElement` when `element` is non-empty and forbidding `SpdxDocument` in `element` or `rootElement`.",
          "lang": "en",
          "state": "draft",
          "drafted_by": {
            "kind": "agent",
            "id": "claude-code",
            "model": "not-disclosed",
            "session": "conversation://60bf5d72-a28c-4963-be20-fa0922d95bc2"
          },
          "drafted_at": "2026-10-26"
        }
      ]
