      "source": "sections/sec-020-dataset-profile-compliance-point.md",
      "source_hash": "b3ed1fed25aa214f0a46dfa15986c86c2c693df8220f9915595c01e995d820d4",
      "narrative": [
        {
          "text": "Section 5.7 (Dataset Profile compliance point): Specifies conformance requirements for exchanging dataset metadata, provenance, structure, licensing, and statistical characteristics for AI systems or other applications under the Dataset Profile.",
          "lang": "en",
          "state": "draft",
          "drafted_by": {
            "kind": "agent",
            "id": "claude-code",
