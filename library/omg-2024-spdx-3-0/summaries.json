    {
      "block": "library/omg-2024-spdx-3-0/blocks/prose-sec-015",
      "source": "sections/sec-015-introduction-to-profiles.md",
      "source_hash": "6be47ee588f5eba0e49259a6bee2df7174d5dbc329c0793668ab61b04b16556d",
      "narrative": [
        {
          "text": "Section 5.2 (Introduction to Profiles): Lists the nine SPDX compliance points (Core, Software, Security, Licensing, Dataset, AI, Build, Lite, and Extension Profiles), specifying that the Core Profile is mandatory and all others are optional.",
          "lang": "en",
          "state": "draft",
          "drafted_by": {
            "kind": "agent",
            "id": "claude-code",
