    {
      "block": "library/omg-2024-spdx-3-0/blocks/prose-sec-007",
      "source": "sections/sec-007-scope.md",
      "source_hash": "dc92ea4a227b142c468aa2c34f1343a685f3684636633e6f723ddea68cd74be9",
      "narrative": [
        {
          "text": "Section 1 (Scope): Defines SPDX as an open standard data model and set of serialization formats for communicating bill of materials (BOM) metadata across software composition (Packages, Files, Snippets), builds, AI models, datasets, identities, provenance, integrity, licensing, security vulnerabilities, element relationships, lifecycle, and annotations.",
          "lang": "en",
          "state": "draft",
          "drafted_by": {
            "kind": "agent",
            "id": "claude-code",
            "model": "not-disclosed",
            "session": "conversation://60bf5d72-a28c-4963-be20-fa0922d95bc2"
          },
          "drafted_at": "2026-10-26"
        }
      ]
    },
