    {
      "block": "library/omg-2024-spdx-3-0/blocks/prose-sec-048",
      "source": "sections/sec-048-externalref.md",
      "source_hash": "6e7b913fa087fe88c704e06631f309d5e9a3260f4d8adf28c004f1310e3631c9",
      "narrative": [
        {
          "text": "Completes the informative property table for `/Core/ElementCollection` and defines Section 8.1.10 (`ExternalIdentifier`), the concrete `/Core/ExternalIdentifier` class for referencing an external resource identifier that uniquely identifies an `Element` via `externalIdentifierType` (`1..1`), `identifier` (`1..1`), `identifierLocator` (`0..*`), `issuingAuthority` (`0..1`), and `comment` (`0..1`).",
          "lang": "en",
          "state": "draft",
          "drafted_by": {
            "kind": "agent",
            "id": "claude-code",
