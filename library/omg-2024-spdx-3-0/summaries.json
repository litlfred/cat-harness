      "source": "sections/sec-021-ai-profile-compliance-point.md",
      "source_hash": "c60790f2e28e24eb6b79406636395d42b58fd72b23195a2b224fb1dfc38a5f37",
      "narrative": [
        {
          "text": "Section 5.8 (AI Profile compliance point): Specifies conformance requirements for exchanging inventories of AI/ML models, frameworks, libraries, versions, licenses, and ethical and security considerations under the AI Profile.",
          "lang": "en",
          "state": "draft",
          "drafted_by": {
