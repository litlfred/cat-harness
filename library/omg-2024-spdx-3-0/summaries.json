    {
      "block": "library/omg-2024-spdx-3-0/blocks/prose-sec-038",
      "source": "sections/sec-038-agent.md",
      "source_hash": "076545b0e5634cd7d65ddf50d1f612fda0ac73bb5c08f7f5c959f8c85ff7d279",
      "narrative": [
        {
          "text": "Section 8.1.1 (`Agent`): Defines the concrete `/Core/Agent` class (subclass of `/Core/Element`) representing any entity with the potential to act on a system—such as a person, organization, or software agent, distinct from tools—along with its inherited properties (`comment`, `creationInfo`, `description`, `extension`, `externalIdentifier`, `externalRef`, `name`, `spdxId`, `summary`, `verifiedUsing`).",
          "lang": "en",
          "state": "draft",
          "drafted_by": {
            "kind": "agent",
            "id": "claude-code",
            "model": "not-disclosed",
            "session": "conversation://60bf5d72-a28c-4963-be20-fa0922d95bc2"
          },
