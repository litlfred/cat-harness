    {
      "block": "library/omg-2024-spdx-3-0/blocks/prose-sec-046",
      "source": "sections/sec-046-externalidentifier.md",
      "source_hash": "f21cd211ac347aa298f880a3f950eb012f4e7ae56ff02d99dc5dcabd4f40e0ab",
      "narrative": [
        {
          "text": "Completes the direct and informative property tables for Section 8.1.8 (`/Core/Element`), covering `comment`, `creationInfo` (`1..1`), `description`, `extension`, `externalIdentifier`, `externalRef`, `name`, `spdxId` (`1..1`), `summary`, and `verifiedUsing`.",
          "lang": "en",
          "state": "draft",
          "drafted_by": {
            "kind": "agent",
