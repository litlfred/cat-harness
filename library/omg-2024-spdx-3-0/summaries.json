    {
      "block": "library/omg-2024-spdx-3-0/blocks/prose-sec-009",
      "source": "sections/sec-009-normative-references.md",
      "source_hash": "81f23f762c5b9f8be672591eb6e1df4e7eed490214954b43cf09dd4db0552ccb",
      "narrative": [
        {
          "text": "Section 2.1 (Normative References): Lists the normative standards and specifications referenced by SPDX 3.0, including CPE 2.2/2.3, CVSS v3.0/v3.1/v4.0, EPSS, SSVC, IEEE POSIX.1-2017, W3C RDF, IETF RFCs for hash digests (MD2, MD4, MD5, SHA-1, SHA-224, SHA-2, BLAKE2), ZLIB, MIME media types, URIs, ABNF, JSON, and CoSWID, SemVer 2.0.0, SLSA Provenance v0.2, SWHID, the SPDX RDF Ontology and License List, and CISA SBOM types.",
          "lang": "en",
          "state": "draft",
          "drafted_by": {
            "kind": "agent",
            "id": "claude-code",
            "model": "not-disclosed",
            "session": "conversation://60bf5d72-a28c-4963-be20-fa0922d95bc2"
          },
          "drafted_at": "2026-10-26"
        }
      ]
    },
    {
      "block": "library/omg-2024-spdx-3-0/blocks/prose-sec-010",
      "source": "sections/sec-010-non-normative-references.md",
      "source_hash": "de09f1e8b1ffaa462eaaef11877c5e6638d18b121cc99e17578873f9be3af62e",
      "narrative": [
        {
          "text": "Section 2.2 (Non-normative References): Lists 11 informative references covering the CISQ 3T-SBOM project, USENIX and congressional testimony on SBOMs, MITRE software supply chain publications, NTIA multistakeholder SBOM documents, OSI Approved Licenses, prior SPDX specification versions 1.0–2.3, and the May 2021 US Executive Order 14028 on cybersecurity.",
          "lang": "en",
          "state": "draft",
          "drafted_by": {
            "kind": "agent",
            "id": "claude-code",
            "model": "not-disclosed",
