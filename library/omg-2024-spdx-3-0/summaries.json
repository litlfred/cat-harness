          "drafted_at": "2026-10-26"
        }
      ]
    },
    {
      "block": "library/omg-2024-spdx-3-0/blocks/prose-sec-032",
      "source": "sections/sec-032-json-ld-context-file.md",
      "source_hash": "b1eaebbec62713c4f30f5b4ee8e07c5b0f82c1d5a6a7e849137f9d3aeaf4b1e3",
      "narrative": [
        {
          "text": "Section 6.5.1 (JSON-LD context file): Requires all SPDX 3.0.1 JSON-LD documents to reference `\"@context\": \"https://spdx.org/rdf/3.0.1/spdx-context.jsonld\"` at the top level, which aliases `@id` as `spdxId` and `@type` as `type` and permits additional namespace mappings.",
          "lang": "en",
          "state": "draft",
          "drafted_by": {
            "kind": "agent",
            "id": "claude-code",
            "model": "not-disclosed",
            "session": "conversation://60bf5d72-a28c-4963-be20-fa0922d95bc2"
          },
          "drafted_at": "2026-10-26"
        }
      ]
    },
    {
      "block": "library/omg-2024-spdx-3-0/blocks/prose-sec-033",
      "source": "sections/sec-033-json-ld-validation.md",
      "source_hash": "895a593bd787e4cc38681681990a2be2c9da84e0231bd3dbe6f943e64fc57c7c",
      "narrative": [
        {
          "text": "Section 6.5.2 (JSON-LD validation): Defines the two conformance criteria for SPDX JSON-LD documents—structural validation against the SPDX JSON Schema (`spdx-json-schema.json`) and semantic validation against the SPDX OWL ontology and SHACL shapes (`spdx-model.ttl`).",
          "lang": "en",
          "state": "draft",
          "drafted_by": {
            "kind": "agent",
            "id": "claude-code",
            "model": "not-disclosed",
            "session": "conversation://60bf5d72-a28c-4963-be20-fa0922d95bc2"
          },
          "drafted_at": "2026-10-26"
        }
      ]
    },
    {
      "block": "library/omg-2024-spdx-3-0/blocks/prose-sec-034",
