# BEGIN index mounts (generated from index.config.json — do not edit)
/bootstrap/
/bootstrap-tools/
# END index mounts

# State branch mounts (Option C)
/beans/**
/fsh-guts/**

# Dependencies: each instance now installs its own (see package.json), so a
# standalone `bun install` leaves these here. Never committed.
node_modules/

# The docs site's local build state (siteDirFor: `docs/`). Until the
# separation these were ignored only by the monorepo root's .gitignore, so a
# standalone clone would `git add -A` a gem tree. Anchored, so the vendored
# assets Jekyll serves (`docs/assets/js/vendor/`, `site-chrome/assets/js/vendor/`)
# stay addable. The Gemfile is the site chrome's (`site-chrome/`), so a bundle
# installed beside it is ignored there too.
/docs/.bundle/
/docs/vendor/
/site-chrome/.bundle/
/site-chrome/vendor/
/docs/_data/build.yml
/docs/_site/

# BEGIN state mounts (generated by state:mount from the declared branch subgraphs — do not edit)
/beans/**
/fsh-guts/**
/issue-marks/**
/test/health/results/**
/todos/**
# END state mounts

# Agent worktree scaffolding (symlinks into an enclosing checkout); never committed.
.claude/worktrees/
