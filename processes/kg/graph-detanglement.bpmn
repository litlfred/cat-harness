      <bpmndi:BPMNEdge id="Edge_SF_Bean_7" bpmnElement="SF_Bean_7"><di:waypoint x="2040" y="925"/><di:waypoint x="2040" y="1132"/><bpmndi:BPMNLabel><dc:Bounds x="2046" y="925" width="80" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
