{
  "@context": {
    "@version": 1.1,
    "ical": "http://www.w3.org/2002/12/cal/ical#",
    "schema": "https://schema.org/",
    "dcterms": "http://purl.org/dc/terms/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "Todo": "ical:Vtodo",
    "Subgraph": "https://litlfred.github.io/bootstrap/0.1.0/ns#Subgraph",
    "inSubgraph": {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#inSubgraph",
      "@type": "@id"
    },
    "contentSource": {
      "@id": "http://purl.org/dc/terms/source",
      "@context": {
        "kind": "https://litlfred.github.io/cat-harness/0.1.0/ns#contentSourceKind",
        "branch": "http://purl.org/dc/terms/identifier",
        "keyedBy": "https://litlfred.github.io/cat-harness/0.1.0/ns#keyedBy",
        "keyFrom": "https://litlfred.github.io/cat-harness/0.1.0/ns#keyFrom",
        "familyRepository": "https://litlfred.github.io/cat-harness/0.1.0/ns#familyRepository",
        "declaredIn": "https://litlfred.github.io/cat-harness/0.1.0/ns#sourceDeclaredIn"
      }
    },
    "Person": "schema:Person",
    "identifier": "schema:identifier",
    "name": "schema:name",
    "summary": "ical:summary",
    "description": "ical:description",
    "status": "ical:status",
    "priority": "ical:priority",
    "created": {
      "@id": "ical:created",
      "@type": "xsd:date"
    },
    "origin": "dcterms:creator",
    "label": "schema:alternateName",
    "target": {
      "@id": "schema:about",
      "@type": "@id"
    },
    "assignee": {
      "@id": "schema:agent",
      "@type": "@id"
    },
    "bean": {
      "@id": "dcterms:isPartOf",
      "@type": "@id"
    },
    "pullRequest": {
      "@id": "dcterms:references",
      "@type": "@id"
    },
    "issue": {
      "@id": "dcterms:references",
      "@type": "@id"
    },
    "process": "dcterms:subject",
    "source": {
      "@id": "dcterms:source",
      "@type": "@id"
    },
    "hasPart": {
      "@id": "dcterms:hasPart",
      "@type": "@id"
    }
  },
  "@graph": []
}
